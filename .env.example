# Copy this file to .env and fill in your keys (for local dev).
# On Colab/Kaggle, set these via os.environ or Secrets instead.

DEEPGRAM_API_KEY=your_deepgram_key_here
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# AI4Bharat — only needed if using the Bhashini Dhruva hosted API.
# Default mode uses HuggingFace local inference (no key required).
# Register at: https://bhashini.gov.in/ulca/user/register
# BHASHINI_API_KEY=your_bhashini_key_here
# USE_BHASHINI_API=1
